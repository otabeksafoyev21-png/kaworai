# ──────────────────────────────────────────────────────────────────────────
#  kaworai_bot — muhit o'zgaruvchilari (environment variables).
#
#  Ushbu faylni `.env` nomi bilan nusxa oling va o'zingizning qiymatlaringizni
#  kiriting. `.env` fayli .gitignore bilan tashlab yuborilgan — hech qachon
#  repositoriyga kommit qilmang.
#
#  Ogohlantirish: barcha maxfiy qiymatlar (BOT_TOKEN, DATABASE_URL, CARD_NUMBER...)
#  *haqiqiy* ma'lumotlarni o'z ichiga oladi, shuning uchun .env faylini
#  xavfsiz saqlang va talab bo'lmagan serverlarga joylamang.
# ──────────────────────────────────────────────────────────────────────────

# === Botning asosiy sozlamalari ===
BOT_TOKEN=123456:AAA-bbb-ccc                  # @BotFather dan olingan token
BOT_USERNAME=kaworai_uz_bot                   # @ siz, `t.me/<username>` shaklida

# === Adminlar ===
# Bir nechta admin kerak bo'lsa, vergul bilan ajrating: `123,456,789`.
ADMIN_ID=123456789

# === Kanallar ===
# Bot foydalanuvchi obuna bo'lishi shart bo'lgan asosiy yangiliklar kanali.
NEWS_CHANNEL_ID=-1001234567890

# Pro foydalanuvchilar uchun yashirin kanal (kontent qo'yiladigan joy).
# Bu — fallback (default). Quyidagi tur bo'yicha alohida kanallar
# berilmagan bo'lsa, hammasi shu kanalga yuboriladi.
SECRET_CHANNEL_ID=-1009876543210
# Tur bo'yicha alohida maxfiy kanallar (auto-add'da kontent turiga qarab
# kerakli kanalga yuborish). 0 yoki bo'sh bo'lsa SECRET_CHANNEL_ID ga
# fallback bo'ladi. Bot har bir kanalda ADMIN bo'lishi shart (yozish
# huquqi).
SECRET_ANIME_CHANNEL_ID=0
SECRET_DORAMA_CHANNEL_ID=0
SECRET_SERIAL_CHANNEL_ID=0
SECRET_KINO_CHANNEL_ID=0
# Bot orqali qism qo'shishda admin videolarini avval stage qilib ko'rish
# uchun kanal (majburiy emas). 0 bo'lsa preview bot DM'ida chiqadi.
PREVIEW_CHANNEL_ID=0

# Davriy ZIP zaxira (animalar + kanallar) yuboriladigan yopiq kanal.
# Bot shu kanalda admin bo'lishi kerak. 0 bo'lsa — zaxira o'chiq.
BACKUP_CHANNEL_ID=0
# Zaxira oralig'i (soat). Standart — 48 soat (2 kunda bir marta).
BACKUP_INTERVAL_HOURS=48

# === Pro to'lov tizimi (Pro payment) ===
# Admin foydalanuvchilarga to'lov cheklari yuboriladigan yopiq kanal.
PAYMENT_CHANNEL_ID=-1001122334455

# To'lov uchun karta raqami — foydalanuvchilar shu kartaga o'tkazma qilishadi.
# Jamoat qo'llanma kartalari bo'lmasin; botda PII ochiqdan-ochiq ko'rsatiladi.
CARD_NUMBER=8600 0000 0000 0000

# Karta egasining ismi — foydalanuvchi sizni ishonchli deb bilishi uchun.
CARD_OWNER=Familiya Ism Otasining ismi

# Admin @username — to'lov tekshiruvida muammo bo'lsa foydalanuvchi murojaat
# qiladigan aloqa. @ belgisi shart emas (kiritsangiz ham xato bermaydi).
ADMIN_USERNAME=sizning_admin_username

# === Ma'lumotlar bazasi / keshlar ===
# PostgreSQL asynchpg URL'i. Format:
#   postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaworai

# Redis — aiogram FSM va throttling uchun.
REDIS_URL=redis://localhost:6379/0

# === Monitoring (ixtiyoriy) ===
# Sentry DSN — xatolarni real vaqtda Sentry panelida ko'rish uchun.
# https://sentry.io dan loyiha yaratib DSN ni nusxalang. Bo'sh bo'lsa Sentry
# o'chiq, bot oddiy ishlayveradi.
SENTRY_DSN=
# Sentry environment nomi (production / staging / dev). Default: production.
SENTRY_ENVIRONMENT=production
# Performance tracing namuna olish darajasi (0.0 = o'chiq, 1.0 = hammasi).
# 200k user'da 0.0 yoki 0.05 tavsiya etiladi (Sentry quota uchun).
SENTRY_TRACES_SAMPLE_RATE=0
# Sentry release tag — qaysi deploy'da xato chiqqanini bilish uchun.
# Bo'sh bo'lsa: RAILWAY_GIT_COMMIT_SHA yoki GIT_COMMIT env'idan avtomatik.
SENTRY_RELEASE=

# === Health check (Railway / K8s probe) ===
# Bot /healthz HTTP endpoint'ini eshitadigan port. 0 bo'lsa — server o'chiq.
# Railway avtomatik ravishda PORT env var'ini beradi; lokal dev uchun 8080.
# /healthz baza ping'ini ham tekshiradi (503 qaytaradi agar DB javob bermasa).
HEALTHCHECK_PORT=8080

# === Structured logging ===
# LOG_FORMAT=json — Railway/Datadog/ELK uchun JSON chiqadi (filter oson).
# LOG_FORMAT=text — lokal o'qish uchun odatiy matn (default).
LOG_FORMAT=text
# LOG_LEVEL=DEBUG | INFO | WARNING | ERROR. Default INFO.
LOG_LEVEL=INFO
# Fayl nomi — bo'sh qolsa fayl chiqarilmaydi (stdout yetarli).
LOG_FILE=bot.log

# === DB connection pool (Railway Postgres = 25 connection limit) ===
# Default: pool_size=10 + max_overflow=5 → jami 15 (Railway'da xavfsiz).
# Boshqa plan ishlatsangiz (Pro/enterprise) — ko'paytirsangiz bo'ladi.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Connection kutish vaqti (sekund) — agar barcha slot band bo'lsa.
DB_POOL_TIMEOUT=30
# Har shuncha sekundda connection yangilanadi (Postgres idle timeout'dan oldin).
DB_POOL_RECYCLE=1800
